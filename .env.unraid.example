# ── Odysseus on Unraid — hardened starting config ──
# Copy to `.env` next to docker-compose.yml, then adjust. See UNRAID.md.

# ============================================================
# Network exposure
# ============================================================
# Expose the web UI so other devices on your LAN can reach it.
#   0.0.0.0      = all interfaces (simplest)
#   <LAN IP>     = only that interface (more specific)
# Leave at 127.0.0.1 if you ONLY access it from the Unraid box itself,
# or if a reverse proxy on a shared Docker network reaches it by name.
APP_BIND=0.0.0.0
APP_PORT=7000

# Unraid's default share user/group (nobody:users) so bind-mounted files
# under /mnt/user/appdata/odysseus stay editable from Unraid.
PUID=99
PGID=100

# ============================================================
# Security — keep these as-is
# ============================================================
AUTH_ENABLED=true            # never disable on a networked box
LOCALHOST_BYPASS=false       # never enable on a networked box

# Set to true ONCE you serve Odysseus over HTTPS (reverse proxy or
# Tailscale Serve). The app also auto-enables Secure cookies when it sees
# an HTTPS request via X-Forwarded-Proto, but setting this is explicit.
SECURE_COOKIES=false

# When you front it with a hostname over HTTPS, list that origin here so
# the browser's credentialed requests are accepted (comma-separated).
# Example:
# ALLOWED_ORIGINS=https://odysseus.example.com,https://unraid.tailXXXX.ts.net
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Optional: pre-seed the first admin password (otherwise one is generated
# and printed to `docker compose logs odysseus`). Change it after first login.
# ODYSSEUS_ADMIN_PASSWORD=

# ============================================================
# Bundled services — leave commented = internal-only (127.0.0.1)
# ============================================================
# Do NOT expose these. Defaults bind to loopback.
# CHROMADB_BIND=127.0.0.1
# NTFY_BIND=127.0.0.1

# ============================================================
# Optional integrations (only if you use them)
# ============================================================
# Point Odysseus at host Ollama (start Ollama with OLLAMA_HOST=0.0.0.0:11434):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
